# Puerto Ceniza — variables de entorno (valores de ejemplo, NO reales).
# El servidor no lee este archivo: define las variables en tu sistema o en el panel del alojamiento.

# Puerto HTTP y WebSocket (/ws). Por defecto 3000.
PORT=3000

# "production" deja los archivos de public/ en caché (en desarrollo se releen en cada petición). Vacío en desarrollo.
NODE_ENV=

# Postgres para cuentas (opcional). Si no hay ninguna, se usa el archivo local data/cuentas.json (solo desarrollo).
# Se prefiere la conexión con pool si existe.
DATABASE_URL_POOLED=postgres://usuario_ficticio:clave_ficticia@host-ficticio.example:5432/puerto_ceniza?sslmode=require
DATABASE_URL=postgres://usuario_ficticio:clave_ficticia@host-ficticio.example:5432/puerto_ceniza?sslmode=require

# --- Solo para el flujo de GitHub Actions que compila el APK Android (se guardan como "secrets" del repositorio) ---
# ANDROID_KEYSTORE_B64=  (keystore .p12 en base64)
# ANDROID_KEYSTORE_PASS=
# ANDROID_KEY_ALIAS=
